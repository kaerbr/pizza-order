<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <!-- For Android 12+ (API 31+) — the new runtime permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Gäste-Bestellung: INTERNET is what allows *listening* on a socket, not talking to a server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 (targetSdk 37) blocks LAN traffic, inbound included, until this is granted at runtime.
         Without it the server starts and then silently never answers a phone. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- The socket has to outlive the screen: without the foreground service the process may be killed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Reading the tablet's own address for the QR code. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Eigener Hotspot: the tablet opens its own local-only WLAN for the guests (GuestHotspot). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Android 13+ asks for "Geräte in der Nähe" before an app may open a hotspot. The app never derives a
         location from it. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!-- Up to Android 12 the same call wants the precise location instead; Android 12 only grants it when
         the approximate one is asked for alongside. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PizzaOrder">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PizzaOrder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the guest page reachable while the tablet is on the kitchen shelf with the screen off. -->
        <service
            android:name=".GuestService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>